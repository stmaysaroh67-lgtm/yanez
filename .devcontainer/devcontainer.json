{
  "name": "yanez-mining-sn54",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive",
    "PYTHONUNBUFFERED": "1"
  },
  "onCreateCommand": "bash -lc 'git config --global --add safe.directory \"*\" || true'",
  "updateContentCommand": "bash -lc 'git config --global --add safe.directory \"*\" || true'",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-miner.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "security.workspace.trust.enabled": false,
        "security.workspace.trust.startupPrompt": "never",
        "security.workspace.trust.untrustedFiles": "open",
        "security.workspace.trust.banner": "never",
        "security.workspace.trust.emptyWindow": true,
        "git.autoRepositoryDetection": true
      }
    }
  },
  "runArgs": ["--init"]
}
